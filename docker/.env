# ============================================================================
# ccloud docker compose 环境变量（仅用于本地开发与联调）
# 以下密码与密钥都是公开的开发值，任何对外环境都必须替换；
# 生产环境请改用各服务的 prod profile，由环境变量或 Nacos 注入，不要使用本文件
# ============================================================================
COMPOSE_PROJECT_NAME=ccloud

# ---------- 本机中间件（scripts/docker-up.sh 默认连接本机已有的实例） ----------
# MySQL、Redis 的密码从本机 mysql / redis 容器的配置读取，Nacos 账号写在 ~/.ccloud/middleware.env，均不进仓库
# 应用容器经 host.docker.internal 访问宿主机上的中间件端口
MIDDLEWARE_HOST=host.docker.internal
MYSQL_PORT=3306
REDIS_PORT=6379
# ccloud 使用的 Redis 库编号：本机 Redis 与其他项目共用，不能用 0
REDIS_DATABASE=1
NACOS_PORT=8848
# ccloud 的配置与服务注册放在独立命名空间，不影响本机 Nacos 上的其他项目
NACOS_NAMESPACE=ccloud
ZIPKIN_PORT=9411

# ---------- 以下仅 docker-compose.middleware.yml 使用（本机没有中间件、由 ccloud 自带一套时） ----------
MYSQL_ROOT_PASSWORD=root123
# 客户端按"服务端口 + 1000"连接 gRPC，修改 NACOS_PORT 时须同步修改
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=8849
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# 鉴权令牌签名密钥，Base64 且解码后不少于 32 字节
NACOS_AUTH_TOKEN=8JwKPJi24UeunTs2I9Fu43Nt+E9fcQMyJuYxptZD1cPFDUmUZB6iiABCE2BW7R7r
NACOS_AUTH_IDENTITY_KEY=ccloud-identity
NACOS_AUTH_IDENTITY_VALUE=ccloud-identity-value

# ---------- XXL-Job 调度中心 ----------
XXL_JOB_PORT=48180
# 调度中心与执行器之间的通信令牌，两侧必须一致
XXL_JOB_ACCESS_TOKEN=8f65de05915c8ae5be1a935602aa6690
# 控制台账号 admin 的密码（替换上游脚本的默认密码 123456）
XXL_JOB_ADMIN_PASSWORD=ccloud123

# ---------- ccloud 应用 ----------
GATEWAY_PORT=48080
SYSTEM_PORT=48081
MEMBER_PORT=48083
MONITOR_PORT=48182
# 网关与各服务共享的内部身份签名密钥
CCLOUD_INTERNAL_SIGN_SECRET=c0521bb3c93d7a44457b07bec71865eba9aaeadcd66f232852023ed312e33107
# 字段加密密钥（16 位）。须与初始化数据加密时使用的密钥一致，更换后已有密文无法解密
CCLOUD_ENCRYPT_KEY=ccloud1234567890
# 监控面板 admin 的密码
CCLOUD_MONITOR_PASSWORD=ccloud123
# 各应用 JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseZGC
