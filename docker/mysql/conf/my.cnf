# ccloud 开发/联调环境的 MySQL 配置
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
# 与应用连接串的 serverTimezone=Asia/Shanghai 一致，避免 datetime 默认值（CURRENT_TIMESTAMP）差 8 小时
default-time-zone = '+08:00'
max_connections = 500
# 开发环境关闭主机名解析，加快连接
skip-name-resolve

[client]
default-character-set = utf8mb4
